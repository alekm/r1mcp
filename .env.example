# RUCKUS One MCP Server Configuration
# Copy this to .env and fill in your values

# OAuth2 client credentials (from the RUCKUS One console)
R1_CLIENT_ID=your_client_id_here
R1_CLIENT_SECRET=your_client_secret_here
R1_TENANT_ID=your_tenant_id_here

# Region: na, eu, or asia
R1_REGION=na

# MSP mode (optional) — set if this tenant is an MSP
# R1_MSP_ID=your_msp_tenant_id_here

# Path to the llm-docs directory (defaults to ./llm-docs relative to server.py)
# R1_DOCS_PATH=/path/to/llm-docs
